{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/steach-IDE/stroma/packages/dsir/schema/dsir-0.3.schema.json",
  "title": "Stroma DSIR 0.3",
  "description": "A design system described for the Stroma emitter: tokens, and per component an ordered list of conditional style rules. Rules are in CSS cascade order: a later rule wins.",
  "type": "object",
  "required": [
    "dsirVersion",
    "source",
    "tokens",
    "globals",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "dsirVersion": {
      "type": "string",
      "pattern": "^0\\.3\\.\\d+$"
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "url",
        "license",
        "hash"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "How it was read, e.g. storybook or shadcn-registry."
        },
        "url": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "description": "SPDX id of the source design system's licence."
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "tokens": {
      "type": "object",
      "required": [
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "object",
          "description": "Token name -> mode name -> sRGB value.",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/srgb"
            }
          }
        },
        "radius": {
          "type": "object",
          "required": [
            "base"
          ],
          "additionalProperties": false,
          "properties": {
            "base": {
              "type": "number",
              "minimum": 0
            },
            "derived": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          }
        },
        "font": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "family"
            ],
            "properties": {
              "family": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "gamutClamped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "globals": {
      "type": "object",
      "description": "Rules every component starts from, by selector ('*', 'body').",
      "additionalProperties": {
        "type": "object",
        "required": [
          "rules"
        ],
        "additionalProperties": false,
        "properties": {
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/rule"
            }
          },
          "noops": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/noop"
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "srgb": {
      "type": "object",
      "required": [
        "hex",
        "alpha"
      ],
      "additionalProperties": false,
      "properties": {
        "hex": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "colorRef": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "token",
            "alpha"
          ],
          "additionalProperties": false,
          "properties": {
            "token": {
              "type": "string"
            },
            "alpha": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "$ref": "#/$defs/srgb"
        },
        {
          "type": "object",
          "required": [
            "transparent"
          ],
          "additionalProperties": false,
          "properties": {
            "transparent": {
              "const": true
            }
          }
        }
      ]
    },
    "length": {
      "type": "number",
      "minimum": 0
    },
    "styleSet": {
      "type": "object",
      "description": "Semantic style values. Closed: a key not listed here is an error, never ignored.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "layout": {
          "enum": [
            "block",
            "row",
            "inlineRow",
            "column",
            "grid"
          ]
        },
        "crossAlign": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "mainAlign": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "gap": {
          "$ref": "#/$defs/length"
        },
        "h": {
          "$ref": "#/$defs/length"
        },
        "w": {
          "$ref": "#/$defs/length"
        },
        "px": {
          "$ref": "#/$defs/length"
        },
        "py": {
          "$ref": "#/$defs/length"
        },
        "pt": {
          "$ref": "#/$defs/length"
        },
        "pb": {
          "$ref": "#/$defs/length"
        },
        "radius": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "token"
              ],
              "additionalProperties": false,
              "properties": {
                "token": {
                  "type": "string",
                  "pattern": "^radius-"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "full"
              ],
              "additionalProperties": false,
              "properties": {
                "full": {
                  "const": true
                }
              }
            },
            {
              "type": "number",
              "minimum": 0,
              "description": "A radius with no token behind it, in logical pixels."
            }
          ]
        },
        "bg": {
          "$ref": "#/$defs/colorRef"
        },
        "fg": {
          "$ref": "#/$defs/colorRef"
        },
        "borderColor": {
          "$ref": "#/$defs/colorRef"
        },
        "ringColor": {
          "$ref": "#/$defs/colorRef"
        },
        "borderWidth": {
          "$ref": "#/$defs/length"
        },
        "ringWidth": {
          "$ref": "#/$defs/length"
        },
        "shadow": {
          "type": "array",
          "description": "In CSS order: the first shadow is painted on top.",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "blur",
              "spread",
              "color"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "blur": {
                "$ref": "#/$defs/length"
              },
              "spread": {
                "type": "number"
              },
              "color": {
                "type": "object",
                "required": [
                  "rgb",
                  "alpha"
                ],
                "additionalProperties": false,
                "properties": {
                  "rgb": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "alpha": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lineHeightFactor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fontWeight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900,
          "multipleOf": 100
        },
        "underline": {
          "type": "boolean"
        },
        "maxLines": {
          "type": "integer",
          "minimum": 1
        },
        "clip": {
          "type": "boolean"
        },
        "transitionMs": {
          "$ref": "#/$defs/length"
        },
        "transitionCurve": {
          "type": "string"
        }
      }
    },
    "when": {
      "type": "object",
      "description": "All conditions must hold. Keys other than the fixed ones name a variant axis of the component; the validator checks that the axis and its value exist.",
      "properties": {
        "mode": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "states": {
          "type": "array",
          "items": {
            "enum": [
              "hovered",
              "focused",
              "pressed",
              "disabled",
              "error"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "hasIcon": {
          "const": true
        },
        "interactive": {
          "const": true
        },
        "hasSlot": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "when",
        "target",
        "set",
        "from",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "when": {
          "$ref": "#/$defs/when"
        },
        "target": {
          "enum": [
            "root",
            "icon"
          ]
        },
        "set": {
          "$ref": "#/$defs/styleSet"
        },
        "from": {
          "type": "string",
          "description": "What produced this rule: a class, a CSS rule, or a measurement id."
        },
        "provenance": {
          "enum": [
            "measured",
            "enricher",
            "llm",
            "human"
          ],
          "description": "Who stated this rule. llm rules must be reviewed before they are trusted."
        },
        "spec": {
          "type": "array",
          "description": "CSS specificity, kept for review.",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "except": {
          "type": "array",
          "description": "Variant combinations where the rule does not apply (removed by tailwind-merge, say).",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "noop": {
      "type": "object",
      "required": [
        "class",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string"
        },
        "why": {
          "type": "string"
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "name",
        "slot",
        "role",
        "behaviour",
        "variants",
        "defaultVariants",
        "slots",
        "rules",
        "noops",
        "unsupported"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "slot": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "behaviour": {
          "description": "The WAI-ARIA pattern the component implements, or null for a static box.",
          "enum": [
            null,
            "button",
            "link",
            "checkbox",
            "switch",
            "radiogroup",
            "tabs",
            "disclosure",
            "accordion",
            "dialog",
            "alertdialog",
            "tooltip",
            "popover",
            "menu",
            "menubar",
            "combobox",
            "listbox",
            "slider",
            "toast"
          ]
        },
        "variants": {
          "type": "object",
          "description": "Axis name -> its options.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "defaultVariants": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "content",
                  "leading",
                  "trailing"
                ]
              },
              "optional": {
                "type": "boolean"
              },
              "dataSlot": {
                "type": "string"
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "noops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noop"
          }
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "what",
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "what": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "fallback": {
                "type": "string"
              }
            }
          }
        },
        "anatomy": {
          "type": "object",
          "description": "How the component is put together from parts. children: the slots of the parts that appear directly inside it, in DOM order.",
          "additionalProperties": false,
          "required": [
            "children"
          ],
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
