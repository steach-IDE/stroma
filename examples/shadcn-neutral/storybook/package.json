{
  "name": "@steach/stroma-example-shadcn-storybook",
  "private": true,
  "version": "0.0.0",
  "description": "A pinned Storybook of shadcn/ui Button, Badge and Card: the input Stroma's extractor reads.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "check": "node scripts/sync.mjs --check",
    "dev": "storybook dev -p 6006 --no-open",
    "build-storybook": "../../../tool/fetch-fonts.sh public/fonts && storybook build -o storybook-static --quiet",
    "test": "pnpm run build-storybook && node --test"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.9",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "playwright": "1.65.1",
    "storybook": "10.6.9",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
