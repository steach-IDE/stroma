{
  "name": "@steach/stroma-example-mui-storybook",
  "private": true,
  "version": "0.0.0",
  "description": "A pinned Storybook of Material UI's Button, a CSS-in-JS system: the probe for render-based extraction without CSS variables.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "storybook dev -p 6008 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test": "pnpm run build-storybook && node --test"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.9",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "playwright": "1.65.1",
    "storybook": "10.6.9",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
