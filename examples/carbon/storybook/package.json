{
  "name": "@steach/stroma-example-carbon-storybook",
  "private": true,
  "version": "0.0.0",
  "description": "A pinned Storybook of Carbon's Button, Tag and Tile: the second design system Stroma's extractor reads.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test": "pnpm run build-storybook && node --test"
  },
  "dependencies": {
    "@carbon/react": "1.121.0",
    "@carbon/styles": "1.120.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.9",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "playwright": "1.65.1",
    "storybook": "10.6.9",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
